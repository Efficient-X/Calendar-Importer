{
  "name": "calendar-importer",
  "version": "1.2.5",
  "description": "Bring external calendar events into your task notes without retyping them.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check": "tsc --noEmit --skipLibCheck && eslint . && vitest run",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "google-calendar",
    "ical",
    "ics",
    "calendar-importer",
    "tasks"
  ],
  "author": "Efficient X Group",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Efficient-X/Calendar-Importer.git"
  },
  "bugs": {
    "url": "https://github.com/Efficient-X/Calendar-Importer/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/efficientx"
  },
  "homepage": "https://github.com/Efficient-X/Calendar-Importer#readme",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "ical.js": "^2.2.1",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@eslint/json": "0.14.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "eslint": "9.39.2",
    "eslint-plugin-obsidianmd": "0.4.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.63.0",
    "vitest": "^4.1.10"
  }
}
